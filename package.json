{
    "name": "minimaz-monorepo",
    "version": "1.0.0",
    "description": "Monorepo for the Minimaz ecosystem.",
    "private": true,
    "license": "MIT",
    "author": "Hans Zeller <info@zellerindustries.com>",
    "type": "module",
    "packageManager": "npm@11.13.0",
    "engines": {
        "node": ">=24",
        "npm": ">=11"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zellerindustries/minimaz-monorepo.git"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo#readme",
    "workspaces": [
        "packages/*",
        "toolkits/*"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "clean": "npm run clean --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
        "typecheck:watch": "tsc -b --watch",
        "lint": "npm run lint --workspaces --if-present && eslint \"*.ts\" \"*.mjs\" scripts",
        "lint:fix": "npm run lint:fix --workspaces --if-present && eslint \"*.ts\" \"*.mjs\" scripts --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "validate": "npm run lint && npm run format:check && npm run typecheck",
        "verify": "npm run validate && npm run build && npm test",
        "verify:release": "npm run verify && changeset status --since=main && npm pack --dry-run --workspaces --silent",
        "prerelease": "npm run verify:release",
        "test": "npm run test --workspaces --if-present && npm run test:scripts",
        "test:scripts": "vitest run --project scripts",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "changeset": "changeset",
        "version": "changeset version && npm install --package-lock-only --ignore-scripts",
        "release": "npm run build && changeset publish",
        "prepare": "husky"
    },
    "devDependencies": {
        "@changesets/changelog-github": "1.0.1",
        "@changesets/cli": "3.0.3",
        "@eslint/js": "10.0.1",
        "@tsconfig/node24": "24.0.5",
        "@types/node": "24.13.6",
        "@vitest/coverage-v8": "5.0.3",
        "esbuild": "0.28.2",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.12.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "prettier": "3.9.9",
        "rimraf": "6.1.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1",
        "vitest": "5.0.3"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,jsonc,yml,yaml,md,mdx,css,scss,html}": [
            "prettier  --write"
        ]
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
