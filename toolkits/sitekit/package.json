{
    "name": "@minimaz/sitekit",
    "version": "0.1.2",
    "description": "The minimaz/mz CLI binary — a published distribution of @minimaz/cli's commands.",
    "type": "module",
    "bin": {
        "minimaz": "dist/cli/main.js",
        "mz": "dist/cli/main.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && node ../../scripts/bundle.mjs",
        "clean": "rimraf ./dist ./node_modules/.cache/tsc",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --project @minimaz/sitekit",
        "prepack": "npm run build",
        "postinstall": "node dist/cli/main.js || exit 0"
    },
    "keywords": [
        "cli",
        "minimaz"
    ],
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "toolkits/sitekit"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/toolkits/sitekit#readme",
    "dependencies": {
        "@minimaz/cli": "^0.3.0"
    }
}
