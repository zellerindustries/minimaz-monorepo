{
    "name": "@minimaz/cleaner-tools",
    "version": "1.0.0",
    "description": "Internal monorepo artifact and cache cleaner utility. Not published.",
    "private": true,
    "type": "module",
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint --config ../../config/eslint.config.mjs .",
        "lint:fix": "eslint --config ../../config/eslint.config.mjs . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --config config/vitest.config.ts tools/cleaner",
        "clean": "rimraf dist"
    },
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "tools/cleaner"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/tools/cleaner#readme",
    "dependencies": {}
}
