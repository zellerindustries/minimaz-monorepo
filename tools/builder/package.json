{
    "name": "@minimaz/builder-tools",
    "version": "1.0.0",
    "description": "Internal esbuild-based bundler for @minimaz/* packages' publish output. Not published.",
    "private": true,
    "type": "module",
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint --config ../../config/eslint.config.mjs .",
        "lint:fix": "eslint --config ../../config/eslint.config.mjs . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --config config/vitest.config.ts tools/builder",
        "clean": "rimraf"
    },
    "author": "",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "tools/builder"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/tools/builder#readme",
    "dependencies": {
        "@minimaz/errors": "^0.1.0",
        "esbuild": "0.28.2"
    }
}
