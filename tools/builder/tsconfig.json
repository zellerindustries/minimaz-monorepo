{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",

        "types": ["node"],

        "composite": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsc/builder.tsbuildinfo",

        "emitDeclarationOnly": false,
        "declarationMap": true,
        "sourceMap": true
    },
    "include": ["src"],
    "exclude": ["dist", "node_modules"]
}
