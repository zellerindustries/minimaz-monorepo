{
    "name": "@minimaz/validate",
    "version": "0.1.0",
    "description": "Structural validators for CSS, HTML, JS, TS, and JSON.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node ../../tools/builder/dist/cli.js",
        "clean": "node -e \"const fs = require('fs'); for (const p of ['dist', 'node_modules/.cache/tsc']) fs.rmSync(p, { recursive: true, force: true });\"",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint --config ../../config/eslint.config.mjs .",
        "lint:fix": "eslint --config ../../config/eslint.config.mjs . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --config config/vitest.config.ts packages/validate",
        "prepack": "npm run build"
    },
    "keywords": [
        "validate",
        "minimaz"
    ],
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/validate"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/validate#readme",
    "dependencies": {
        "typescript": "6.0.3"
    }
}
