{
    "name": "@minimaz/local-server",
    "version": "0.2.0",
    "description": "Lightweight, dependency-free local HTTP server with live reload for serving a built site during development.",
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "keywords": [
        "minimaz",
        "server",
        "dev-server",
        "live-reload"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && node ../../scripts/bundle.mjs",
        "clean": "rimraf ./dist ./node_modules/.cache/tsc",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --project @minimaz/local-server",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/local-server"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/local-server#readme",
    "dependencies": {
        "@minimaz/logger": "^0.2.0"
    }
}
