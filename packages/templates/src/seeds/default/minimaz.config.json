{
    "input": {
        "dir": "./src",
        "mapping": {
            "pages": "",
            "scripts": "",
            "styles": "",
            "public": ""
        },
        "exclude": [],
        "externals": {}
    },
    "output": {
        "dir": "./dist",
        "replace": {
            "_DOMAIN_": "example.com",
            "_SITE_NAME_": "Acme Studio"
        },
        "css": { "bundling": true, "minify": true },
        "js": { "bundling": false, "minify": true },
        "html": { "minify": true }
    },
    "serve": {
        "port": 3000,
        "host": "localhost",
        "liveReload": true,
        "cleanUrls": true,
        "singlePageApp": false,
        "directoryListing": false,
        "cacheControl": false
    }
}
