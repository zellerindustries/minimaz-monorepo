{
    "name": "@minimaz/templates",
    "version": "0.3.0",
    "description": "Manages the global ~/.minimaz directory: settings and template storage.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && node ../../scripts/bundle.mjs && node ../../scripts/copy-seeds.mjs",
        "clean": "rimraf ./dist ./node_modules/.cache/tsc",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --project @minimaz/templates",
        "prepack": "npm run build"
    },
    "keywords": [
        "templates",
        "minimaz"
    ],
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/templates"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/templates#readme",
    "dependencies": {
        "@minimaz/core": "^0.3.0",
        "@minimaz/logger": "^0.2.1"
    }
}
