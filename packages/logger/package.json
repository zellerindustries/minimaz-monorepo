{
    "name": "@minimaz/logger",
    "version": "0.1.0",
    "description": "Minimal, performance-oriented structured logger for Minimaz tools",
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "keywords": [
        "minimaz",
        "logger",
        "logging",
        "structured-data",
        "minimal"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node ../../tools/builder/dist/main.js",
        "clean": "node -e \"const fs = require('fs'); for (const p of ['dist', 'node_modules/.cache/tsc']) fs.rmSync(p, { recursive: true, force: true });\"",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint --config ../../eslint.config.mjs .",
        "lint:fix": "eslint --config ../../eslint.config.mjs . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --config config/vitest.config.ts packages/logger",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/logger"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/logger#readme"
}
