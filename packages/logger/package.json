{
    "name": "@minimaz/logger",
    "version": "0.2.0",
    "description": "Minimal, performance-oriented structured logger for Minimaz tools",
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "keywords": [
        "minimaz",
        "logger",
        "logging",
        "structured-data",
        "minimal"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && node ../../scripts/bundle.mjs",
        "clean": "rimraf ./dist ./node_modules/.cache/tsc",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --project @minimaz/logger",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/logger"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/logger#readme"
}
