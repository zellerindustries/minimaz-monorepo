{
    "name": "@minimaz/markdown",
    "version": "0.2.1",
    "description": "Dependency-free Markdown parser with HTML and PDF renderers (MdToHtml, MdToPdf, validateMd).",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && node ../../scripts/bundle.mjs",
        "clean": "rimraf ./dist ./node_modules/.cache/tsc",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --project @minimaz/markdown",
        "prepack": "npm run build"
    },
    "keywords": [
        "markdown",
        "html",
        "pdf",
        "parser"
    ],
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/markdown"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/markdown#readme"
}
