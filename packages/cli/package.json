{
    "name": "@minimaz/cli",
    "version": "0.5.0",
    "description": "Command implementations for the minimaz/mz CLI. Not published as a bin itself — see @minimaz/sitekit.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -b tsconfig.build.json && node ../../scripts/bundle.mjs",
        "clean": "rimraf ./dist ./node_modules/.cache/tsc",
        "typecheck": "tsc -b",
        "typecheck:watch": "tsc -p tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "validate": "npm run lint && npm run typecheck",
        "test": "vitest run --root ../.. --project @minimaz/cli",
        "prepack": "npm run build"
    },
    "keywords": [
        "cli",
        "minimaz"
    ],
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/cli#readme",
    "dependencies": {
        "@minimaz/bundler": "^0.3.0",
        "@minimaz/config": "^0.4.0",
        "@minimaz/core": "^0.3.1",
        "@minimaz/css": "^0.2.0",
        "@minimaz/html": "^0.1.1",
        "@minimaz/js": "^0.2.0",
        "@minimaz/logger": "^0.2.1",
        "@minimaz/local-server": "^0.3.1",
        "@minimaz/markdown": "^0.2.1",
        "@minimaz/templates": "^0.3.0",
        "@minimaz/ts": "^0.1.0",
        "@minimaz/validate": "^0.1.2",
        "cross-spawn": "7.0.6"
    },
    "devDependencies": {
        "@types/cross-spawn": "6.0.6"
    }
}
