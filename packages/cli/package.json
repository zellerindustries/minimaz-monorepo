{
    "name": "@minimaz/cli",
    "version": "0.1.0",
    "description": "minimaz/mz CLI — help, version, validate, init, config, template, docs.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "minimaz": "./dist/cli/main.js",
        "mz": "./dist/cli/main.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node ../../tools/builder/dist/cli.js",
        "clean": "node -e \"const fs = require('fs'); for (const p of ['dist', 'node_modules/.cache/tsc']) fs.rmSync(p, { recursive: true, force: true });\"",
        "prepack": "npm run build",
        "dev": "tsx src/cli/main.ts",
        "typecheck": "tsc --noEmit",
        "postinstall": "node dist/cli/main.js || exit 0"
    },
    "keywords": [
        "cli",
        "minimaz"
    ],
    "author": "Hans Zeller <info@zellerindustries.com>",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zellerindustries/minimaz-monorepo.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/zellerindustries/minimaz-monorepo/issues"
    },
    "homepage": "https://github.com/zellerindustries/minimaz-monorepo/tree/main/packages/cli#readme",
    "dependencies": {
        "@minimaz/config": "^0.1.0",
        "@minimaz/core": "^0.1.0",
        "@minimaz/logger": "^0.1.0",
        "@minimaz/markdown": "^0.1.0",
        "@minimaz/templates": "^0.1.0",
        "@minimaz/validate": "^0.1.0",
        "cross-spawn": "7.0.6"
    },
    "devDependencies": {
        "@types/cross-spawn": "6.0.6"
    }
}
