        { "path": "../js/tsconfig.build.json" },
        { "path": "../logger/tsconfig.build.json" },
        { "path": "../markdown/tsconfig.build.json" },
        { "path": "../templates/tsconfig.build.json" },
        { "path": "../ts/tsconfig.build.json" },
        { "path": "../validate/tsconfig.build.json" }
    ]
