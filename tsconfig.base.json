{
    "extends": "@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "target": "ES2024",
        "lib": ["ES2024"],

        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "types": ["node"],

        // Monorepo requirement for `tsc -b`
        "composite": true,
        "incremental": true,

        "strict": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noPropertyAccessFromIndexSignature": true,

        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,

        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "resolveJsonModule": true,

        // Only generates .d.ts files (Assumes esbuild/vite handles the .js output)
        "declaration": true, // Must be true when composite is true
        "emitDeclarationOnly": false, // Emits both .js and .d.ts
        "declarationMap": false,
        "sourceMap": false
    },
    // Do NOT exclude tests here, so `tsc -b` will still typecheck them.
    "exclude": ["dist", "node_modules"]
}
