# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs.
# https://editorconfig.org

# Top-most EditorConfig file. Tells the plugin to stop looking up the folder tree.
root = true

# Global defaults for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown files
[*.md]
# Markdown uses two trailing spaces to signify a hard line break (<br>).
# We turn off trailing whitespace trimming to prevent breaking this feature.
trim_trailing_whitespace = false